# =============================================================================
# Environment template (SAFE TO COMMIT)
# Copy to .env / .env.qa / .env.staging / .env.production and fill real values.
# Select env at runtime: TEST_ENV=qa npm test   (see config/env.config.js)
# =============================================================================

# Target application (required for UI tests)
BASE_URL=http://127.0.0.1:3000

# API host (optional — defaults to BASE_URL when empty)
API_BASE_URL=

# Opt-in only: set true behind corporate TLS inspection labs (default false)
IGNORE_HTTPS_ERRORS=false

# --- Personas / credentials (required when auth tests run) ---
# Never commit real passwords. Use secrets in CI (GitHub Actions / Jenkins).

ADMIN_EMAIL=
ADMIN_PASSWORD=

USER_EMAIL=
USER_PASSWORD=
